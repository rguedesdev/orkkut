PORT=5000
MONGODB_URI=mongodb://localhost:27017
JWT_SECRET=change-me
NODE_ENV=development

# URL pública deste backend, usada nas URLs de mídia retornadas pelo GraphQL.
API_PUBLIC_URL=http://localhost:5000

# local é permitido somente fora de produção. Use s3 em produção.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.uploads

# Configuração para AWS S3, Cloudflare R2 ou MinIO.
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_BASE_URL=

# Limpeza: pendentes/falhas após 24h; órfãs prontas após 7 dias.
MEDIA_PENDING_MAX_AGE_HOURS=24
MEDIA_ORPHAN_MAX_AGE_HOURS=168
MEDIA_CLEANUP_INTERVAL_MINUTES=60
